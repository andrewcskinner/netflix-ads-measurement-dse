# Copy to .streamlit/secrets.toml locally, or paste into the Streamlit Community
# Cloud "Secrets" UI when deploying. If absent, the app falls back to the demo
# credentials baked into src/auth.py (username "netflix").
#
# To rotate the password: python -c "import hashlib; print(hashlib.sha256('newpass'.encode()).hexdigest())"
AUTH_USERNAME = "netflix"
AUTH_PASSWORD_SHA256 = "replace-with-sha256-hex-of-your-password"

# --- AI Analyst page (optional) ---
# Enables the LLM-backed semantic layer + summarization on the AI Analyst page.
# Without it, that page runs in a deterministic offline fallback (it still works).
# OPENAI_API_KEY = "sk-..."
# OPENAI_MODEL   = "gpt-4o-mini"   # optional; this is the default
